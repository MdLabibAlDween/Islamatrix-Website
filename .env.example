# Copy to .env.local and fill in values from Supabase Dashboard → Settings → API
# and the EmailJS dashboard. NEVER commit real keys (.env.local is git-ignored).
# Only .env.example is committed — it documents every variable with safe placeholders.

# Canonical public URL of the deployed site (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://labibaldween.com

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (seed/audit scripts + server client). NEVER prefix with NEXT_PUBLIC_,
# NEVER use in browser code. Keep only on your machine / hosting provider secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site defaults (overridable anytime in Admin → site_settings).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/mdlabibaldween/30min
NEXT_PUBLIC_AGENCY_NAME=Islamatrix
NEXT_PUBLIC_CONTACT_EMAIL=labib@labibaldween.com
# Legacy alias kept for backwards compatibility with existing .env.local files.
CONTACT_EMAIL=labib@labibaldween.com

# EmailJS contact form (https://dashboard.emailjs.com) — public values, safe for the browser.
# Template variables used: {{from_name}} {{from_email}} {{reply_to}} {{business}}
# {{service}} {{budget}} {{timeline}} {{message}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key
